{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && data.val() === auth.uid))"
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && !data.exists() && newData.child('hostUid').val() === auth.uid && newData.child('status').val() === 'waiting' && newData.child('maxPlayers').val() > 0 && newData.child('maxPlayers').val() <= 10 && newData.child('targetSteps').val() > 0",
        "status": {
          ".write": "auth != null && data.parent().child('players').child(auth.uid).exists() && ((data.val() === 'waiting' && newData.val() === 'in_progress') || (data.val() === 'in_progress' && newData.val() === 'finished') || (data.val() === 'finished' && newData.val() === 'waiting'))"
        },
        "winnerUid": {
          ".write": "auth != null && data.parent().child('players').child(auth.uid).exists() && (!data.exists() || newData.val() === null)"
        },
        "roundId": {
          ".write": "auth != null && data.parent().child('players').child(auth.uid).exists() && ((!data.exists() && newData.isString()) || (data.exists() && newData.val() === null))"
        },
        "roundStartedAt": {
          ".write": "auth != null && data.parent().child('players').child(auth.uid).exists() && ((!data.exists() && newData.isNumber()) || (data.exists() && newData.val() === null))"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || data.parent().parent().child('status').val() === 'waiting')",
            "isEliminated": {
              ".write": "auth != null && auth.uid === $uid && (data.val() != true || data.parent().parent().parent().child('status').val() === 'waiting')"
            }
          }
        },
        "playAgainRequest": {
          ".write": "auth != null && data.parent().child('players').child(auth.uid).exists() && ((!data.exists() && newData.child('requestedBy').val() === auth.uid && newData.child('acceptedBy').child(auth.uid).val() === true && !newData.hasChild('declinedBy')) || !newData.exists())",
          "acceptedBy": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('requestedBy').exists() && data.parent().parent().parent().child('players').child(auth.uid).exists() && newData.val() === true"
            }
          },
          "declinedBy": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('requestedBy').exists() && data.parent().parent().parent().child('players').child(auth.uid).exists() && newData.isString()"
            }
          }
        }
      }
    },
    "gameHistory": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": "finishedAt",
        "$roundId": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()"
        }
      }
    },
    "opponents": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": "lastPlayedAt",
        "$opponentUid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
