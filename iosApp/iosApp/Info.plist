<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>FIREBASE_DATABASE_URL</key>
	<string>https://balance-the-ball-2f0a8-default-rtdb.europe-west1.firebasedatabase.app/</string>
	<key>FIREBASE_PROJECT_ID</key>
	<string>balance-the-ball-2f0a8</string>
	<key>NSMotionUsageDescription</key>
	<string>Balance The Ball uses motion sensors to move the ball and count your steps.</string>
	<!--
	  Lets the app process a remote (push) notification's data payload while backgrounded, not
	  just when foregrounded. The other half of push support — the "Push Notifications" capability
	  itself (entitlements + provisioning profile) — has to be added in Xcode's Signing &
	  Capabilities tab, since that also touches the App ID on Apple's servers.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!--
	  Google Sign-In redirect URL scheme. Once Google Sign-In is enabled in the Firebase Console
	  and GoogleService-Info.plist is re-downloaded, copy its REVERSED_CLIENT_ID value in below
	  (replacing the placeholder) — without this, the OAuth redirect back into the app will hang.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>REPLACE_WITH_REVERSED_CLIENT_ID</string>
			</array>
		</dict>
	</array>
</dict>
</plist>